{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "compass-server",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "COMPASS_DEBUG=1",
        "npm",
        "run",
        "start",
        "-w",
        "server"
      ],
      "port": 8890
    },
    {
      "name": "iconnect-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "iconnect-demo",
        "--",
        "--port",
        "4200",
        "--host",
        "127.0.0.1"
      ],
      "port": 4200
    },
    {
      "name": "studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "studio",
        "--",
        "--port",
        "5310",
        "--no-open",
        "--app",
        "examples/iconnect-demo"
      ],
      "port": 5310
    }
  ]
}

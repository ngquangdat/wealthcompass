{
  "name": "wealthcompass",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "server",
    "examples/*"
  ],
  "scripts": {
    "scan": "tsx packages/cli/src/main.ts scan --config examples/iconnect-demo/compass.config.yaml",
    "server": "npm run start -w server",
    "demo": "npm run start -w iconnect-demo -- --port 4200 --host 127.0.0.1",
    "test": "tsx --test server/src/agent.test.ts packages/cli/src/scan.test.ts packages/cli/src/template.test.ts packages/cli/src/record/record.test.ts",
    "check": "tsc --noEmit -p server && tsc --noEmit -p packages/cli && npm run test",
    "tour:record": "tsx packages/cli/src/main.ts tour:record --config examples/iconnect-demo/compass.config.yaml"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2"
  }
}

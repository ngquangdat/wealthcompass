# Cấu hình backend WealthCompass tự host. Sao chép thành server/.env hoặc đặt biến môi trường.

# --- LLM (endpoint tương thích OpenAI: DeepSeek, Gemini, vLLM/Ollama on-prem...) ---
# Preset: deepseek (mặc định, model deepseek-v4-flash) hoặc gemini (model gemini-3.5-flash).
COMPASS_LLM_PROVIDER=deepseek
# Ghi đè preset khi dùng endpoint khác:
# COMPASS_LLM_BASE_URL=
# COMPASS_LLM_MODEL=
# COMPASS_LLM_REASONING_EFFORT=low
# Thứ tự tìm khóa: COMPASS_LLM_API_KEY -> DEEPSEEK_API_KEY/GOOGLE_API_KEY (theo preset) ->
# đúng biến đó trong file COMPASS_ENV_FILE nếu bạn đặt (chỉ đọc một biến, không nạp cả file; không có mặc định).
# Môi trường thật: đặt COMPASS_LLM_API_KEY bằng secret của hệ thống.
COMPASS_LLM_API_KEY=

# --- Xác thực: JWKS của hệ thống đăng nhập của khách ---
# Demo dùng IdP giả lập chạy cùng server (COMPASS_MOCK_IDP=1). Web thật: tắt IdP giả và trỏ JWKS thật.
COMPASS_MOCK_IDP=1
COMPASS_JWKS_URL=http://127.0.0.1:8890/idp/jwks.json
COMPASS_JWT_ISSUER=https://idp.demo.local
COMPASS_JWT_AUDIENCE=wealthcompass-demo
# Tên claim chứa quyền (mảng hoặc chuỗi cách nhau bằng dấu cách)
COMPASS_CAPABILITIES_CLAIM=roles

# --- Khác ---
PORT=8890
COMPASS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
COMPASS_FEATURE_MAP=examples/iconnect-demo/feature-map.json
COMPASS_PACK=packs/finance-vn
COMPASS_RATE_MAX=30

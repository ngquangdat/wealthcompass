# Cấu hình backend WealthCompass tự host. Sao chép thành server/.env hoặc đặt biến môi trường.

# --- LLM (endpoint tương thích OpenAI: Gemini, DeepSeek, vLLM/Ollama on-prem...) ---
# Mặc định dùng Gemini qua endpoint tương thích OpenAI.
COMPASS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
COMPASS_LLM_MODEL=gemini-3.5-flash
# Thứ tự tìm khóa: COMPASS_LLM_API_KEY -> GOOGLE_API_KEY -> biến GOOGLE_API_KEY trong COMPASS_ENV_FILE
# (mặc định ~/tcbs-agent/.env; chỉ đọc đúng một biến đó, không nạp cả file).
COMPASS_LLM_API_KEY=

# --- Xác thực: JWKS của hệ thống đăng nhập của khách ---
# Demo dùng IdP giả lập chạy cùng server (COMPASS_MOCK_IDP=1). Web thật: tắt IdP giả và trỏ JWKS thật.
COMPASS_MOCK_IDP=1
COMPASS_JWKS_URL=http://127.0.0.1:8890/idp/jwks.json
COMPASS_JWT_ISSUER=https://idp.demo.local
COMPASS_JWT_AUDIENCE=wealthcompass-demo

# --- Khác ---
PORT=8890
COMPASS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
COMPASS_FEATURE_MAP=examples/iconnect-demo/feature-map.json
COMPASS_PACK=packs/finance-vn
COMPASS_RATE_MAX=30
